# ─────────────────────────────────────────────────────────────
# PartSelect Agent — backend configuration
# Copy this file to `.env` and fill in your key.
# The agent is provider-agnostic; pick ONE provider block below.
# ─────────────────────────────────────────────────────────────

# ===== OpenAI (active default) =====
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-key-here

# ===== Anthropic =====
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ===== Deepseek (OpenAI-compatible) =====
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-chat
# OPENAI_API_KEY=your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com

# ===== Groq (OpenAI-compatible) =====
# LLM_PROVIDER=openai
# LLM_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=your-groq-key
# LLM_BASE_URL=https://api.groq.com/openai/v1

# ───── Optional tuning (sane defaults applied if omitted) ─────
# LLM_MAX_TOKENS=1024
# MAX_TOOL_STEPS=6
# CORS_ORIGINS=http://localhost:3000

# ───── Hybrid live catalog (OFF by default) ─────
# PartSelect's CDN (Akamai) returns 403 to server-side requests, so live fetch
# only works with curl_cffi installed (browser TLS impersonation):
#     pip install curl_cffi
# Then set LIVE_FETCH=true to fetch parts/models not in data/*.json on demand
# and persist them locally. Left off, the app serves the curated catalog only.
LIVE_FETCH=false
LIVE_DELAY=1.5
# LIVE_CACHE_DIR=data/.live_cache
# Resolve bare PS numbers (e.g. "install PS11745496") to their page URL.
LIVE_RESOLVE_VIA_SITEMAP=true
